# 复制为 /data/deployhook/deployhook.env，由 root 保管，权限设为 0600。
DEPLOYHOOK_LISTEN=127.0.0.1:8787
# 使用 openssl rand -hex 32 生成字符串后替换，不要填命令本身。
DEPLOYHOOK_SECRET=
# 指向自己的脚本，脚本可以位于其他目录。
DEPLOYHOOK_SCRIPT=/data/myapp/update.sh
# 可选：脚本 stdout/stderr 写入此文件，每次执行覆盖；留空则进入 journald。
DEPLOYHOOK_SCRIPT_LOG=/data/deployhook/state/update.log
RUST_LOG=info
